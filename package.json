{
  "name": "requirement-hover",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "lucas",
  "private": true,
  "license": "UNLICENSED",
  "author": "Lucas Bueno",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucxsbueno/rf-hover.git"
  },
  "bugs": {
    "url": "https://github.com/lucxsbueno/rf-hover/issues"
  },
  "homepage": "https://github.com/lucxsbueno/rf-hover#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/lucxsbueno"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "keywords": [
    "requirements",
    "requirement",
    "requisitos",
    "RF",
    "RN",
    "RNF",
    "hover",
    "traceability",
    "spec"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "rfHover.prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "default": [],
          "markdownDescription": "%configuration.prefixes.description%"
        },
        "rfHover.disabledPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "default": [],
          "markdownDescription": "%configuration.disabledPrefixes.description%"
        },
        "rfHover.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-br"
          ],
          "enumDescriptions": [
            "%configuration.language.enum.auto%",
            "%configuration.language.enum.en%",
            "%configuration.language.enum.ptBr%"
          ],
          "default": "auto",
          "markdownDescription": "%configuration.language.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/requirements.test.js out/test/i18n.test.js out/test/hover.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
